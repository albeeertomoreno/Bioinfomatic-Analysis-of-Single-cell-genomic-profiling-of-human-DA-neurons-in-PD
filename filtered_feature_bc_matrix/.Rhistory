error_msg <- paste0(error_msg, " You might need to normalize the '", assay_to_use, "' assay first (e.g., using Seurat::NormalizeData) to create the 'data' layer.")
} else if (!"counts" %in% available_layers && expression_layer_name == "counts") {
error_msg <- paste0(error_msg, " The 'counts' layer itself is missing.")
}
} else {
error_msg <- paste0(error_msg, "No data layers found in this assay.")
}
stop(error_msg)
}
# GetAssayData should still be fine with Seurat:: as it's a workhorse exported function
new_expression_data <- Seurat::GetAssayData(object = new, assay = assay_to_use, layer = expression_layer_name)
new_expression_data_shared <- new_expression_data[shared_features, , drop = FALSE]
# ... (rest of the project_query_v2 function) ...
if (ncol(new_expression_data_shared) == 0) {
stop("No cells found in the 'new' object after subsetting for shared features. Check input.")
}
if (nrow(new_expression_data_shared) == 0) {
stop("No shared features found in the data matrix after attempting to subset. This shouldn't happen if length(shared_features)>0. Check for NA/empty rownames.")
}
# --- 3c. Scaling and Projection (as per original logic) ---
message(crayon::green(cli::symbol$record, " Step 2: Scaling data and projecting into reference PCA space..."))
ref_loadings_shared <- ref_loadings[shared_features, , drop = FALSE]
means <- spmodel@scaling$means[shared_features]
stdevs <- spmodel@scaling$stdevs[shared_features]
# Handle cases where stdevs might be NA or zero for shared features
# (e.g. if a feature was all-zero in ref during training but present in query)
if(any(is.na(means)) || any(is.na(stdevs))){
na_means_features <- names(means[is.na(means)])
na_stdevs_features <- names(stdevs[is.na(stdevs)])
bad_scaling_features <- unique(c(na_means_features, na_stdevs_features))
message(crayon::yellow("\t", cli::symbol$warning, paste0("Found ", length(bad_scaling_features), " shared features with NA scaling parameters (means/stdevs). These features will be excluded from projection.")))
# Exclude these problematic features
shared_features_for_scaling <- setdiff(shared_features, bad_scaling_features)
if(length(shared_features_for_scaling) < 5){
stop("Too few features remaining after excluding those with NA scaling parameters. Cannot proceed.")
}
new_expression_data_shared <- new_expression_data_shared[shared_features_for_scaling, , drop = FALSE]
ref_loadings_shared <- ref_loadings[shared_features_for_scaling, , drop = FALSE]
means <- spmodel@scaling$means[shared_features_for_scaling]
stdevs <- spmodel@scaling$stdevs[shared_features_for_scaling]
}
# Transpose new_expression_data_shared for scaling (cells by features)
new_expression_data_t <- Matrix::t(new_expression_data_shared)
# Identify zero-variance features in the reference scaling parameters *that are still present*
zero_variance_stdevs_idx <- (stdevs == 0)
if (any(zero_variance_stdevs_idx)) {
num_zero_var <- sum(zero_variance_stdevs_idx)
warning(paste0(num_zero_var, " shared features had zero variance in the reference during training (stdev=0). These features will be effectively removed from projection for the new data, or cause NaNs if not handled by scale()."))
# The standard scale() function handles stdev=0 by not scaling those columns (outputting 0s if center=TRUE and data matched mean, or original if center=FALSE, or NaNs/Infs if data != mean).
# scPred's original code removed these, let's see if `scale` handles it or if we need to replicate the removal.
# If means[zero_variance_stdevs_idx] makes sense and data is also that mean, then (x-mean)/stdev -> 0/0 -> NaN.
# It's often safer to remove such features before scaling if stdev is truly 0.
# However, scPred's original logic was:
# i <- stdevs == 0 ... new_data <- new_data[, !i]; ref_loadings <- ref_loadings[!i, ]; means <- means[!i]; stdevs <- stdevs[!i]
# This was applied AFTER data was transposed.
# Let's apply this logic carefully.
if(any(zero_variance_stdevs_idx)){
message(crayon::yellow("\t", cli::symbol$info, "Removing features with zero standard deviation in reference scaling parameters from projection."))
# Features to keep for scaling are those where stdevs != 0
features_to_keep_idx <- !zero_variance_stdevs_idx
new_expression_data_t <- new_expression_data_t[, features_to_keep_idx, drop = FALSE]
ref_loadings_shared <- ref_loadings_shared[features_to_keep_idx, , drop = FALSE]
means <- means[features_to_keep_idx]
stdevs <- stdevs[features_to_keep_idx]
if(ncol(new_expression_data_t) < 1 || nrow(ref_loadings_shared) < 1){
stop("No features left for projection after removing zero-variance features. Check reference model training.")
}
}
}
# Perform scaling: (data - center) / scale
# The `scale` function in R handles this.
# It expects data where columns are variables (features).
scaled_new_data <- scale(new_expression_data_t, center = means, scale = stdevs)
# Check for NaNs produced by scaling (e.g. 0/0 if a feature was constant in new data and matched mean)
if(any(is.na(scaled_new_data))){
num_nans <- sum(is.na(scaled_new_data))
message(crayon::yellow("\t", cli::symbol$warning, paste0(num_nans, " NaN values produced after scaling. This can happen if new data has features with zero variance that also match the reference mean, or if a feature that had variance in reference is all 0s in query. These will be converted to 0.")))
scaled_new_data[is.na(scaled_new_data)] <- 0 # Replace NaNs with 0
}
# Project scaled data into reference PCA space
new_embeddings_projection_only <- scaled_new_data %*% ref_loadings_shared
# --- 3d. Harmony Alignment (as per original logic) ---
message(crayon::green(cli::symbol$record, " Step 3: Aligning new data to reference using Harmony..."))
ref_cell_embeddings <- spmodel@cell_embeddings
# Ensure column names match for rbind
if(!identical(colnames(ref_cell_embeddings), colnames(new_embeddings_projection_only))){
# This can happen if PCA dimensions differ slightly or names are off.
# scPred model stores PCs, new projection should match these.
# If new_embeddings_projection_only has more/less cols, this is an issue.
# The colnames(new_embeddings_aligned) <- colnames(spmodel@cell_embeddings) from original scPredict was after harmony.
# For Harmony, they must match before rbind.
# ref_loadings_shared drives the colnames of new_embeddings_projection_only.
# And ref_cell_embeddings should also match those PC names.
# This implies colnames(ref_loadings_shared) should match colnames(ref_cell_embeddings) conceptually.
# Let's assume they do match as per scPred's internal consistency.
warning("Column names of reference embeddings and new projected embeddings do not perfectly match. This might cause issues with Harmony if PC names are inconsistent. Proceeding with caution.")
# A safer approach might be to intersect colnames or ensure spmodel internals are consistent.
# For now, assuming they are compatible as per scPred's design.
}
# Create combined data for Harmony
# Ensure unique rownames for Harmony
harmony_ref_embeddings <- ref_cell_embeddings
rownames(harmony_ref_embeddings) <- paste0("ref_", rownames(harmony_ref_embeddings))
harmony_new_embeddings <- new_embeddings_projection_only
rownames(harmony_new_embeddings) <- paste0("new_", rownames(harmony_new_embeddings))
combined_embeddings <- rbind(harmony_ref_embeddings, harmony_new_embeddings)
meta_data_harmony <- data.frame(
original_rownames = rownames(combined_embeddings), # Keep track for later
dataset = factor(
c(rep("reference", nrow(harmony_ref_embeddings)), rep("new", nrow(harmony_new_embeddings))),
levels = c("reference", "new")
)
)
rownames(meta_data_harmony) <- meta_data_harmony$original_rownames
set.seed(seed)
# The '...' passes additional arguments to HarmonyMatrix if any are provided to project_query_v2
harmony_aligned_embeddings <- harmony::HarmonyMatrix(
data_mat = combined_embeddings,
meta_data = meta_data_harmony,
vars_use = "dataset", # Variable to integrate over
do_pca = FALSE,       # PCA already done
reference_values = "reference", # Which dataset level is the reference
max.iter.harmony = max.iter.harmony,
...
)
# Extract aligned embeddings for the new dataset
new_embeddings_aligned <- harmony_aligned_embeddings[meta_data_harmony$dataset == "new", , drop = FALSE]
# Restore original rownames for the new data
original_new_rownames <- rownames(new_embeddings_projection_only) # These are the cell names from 'new'
rownames(new_embeddings_aligned) <- original_new_rownames
} else { # alignment_needed is FALSE
message(crayon::blue(cli::symbol$info, "Skipping alignment. Using existing 'scpred' reduction."))
new_embeddings_aligned <- Seurat::Embeddings(new, reduction = "scpred")
# Original scPredict code had:
# colnames(new_embeddings_aligned) <- gsub("scpred_", spmodel@reduction_key, colnames(new_embeddings_aligned))
# This line is a bit confusing as reduction_key is usually like "PC_" or "harmony_" not part of "scpred_"
# And spmodel@reduction_key is for the *reference* model reduction.
# Let's assume 'scpred' reduction in 'new' already has appropriate colnames.
# If original scpred_projection is needed, it should also be fetched or ensured it exists.
if ("scpred_projection" %in% names(new@reductions)) {
new_embeddings_projection_only <- Seurat::Embeddings(new, reduction = "scpred_projection")
}
}
# --- 4. Store Embeddings in 'new' Seurat Object ---
message(crayon::green(cli::symbol$record, " Step 4: Storing new embeddings in the Seurat object..."))
# Ensure new_embeddings_aligned is not NULL (e.g. if alignment was skipped and no 'scpred' reduction found)
if(is.null(new_embeddings_aligned)){
stop("Aligned embeddings are NULL. This should not happen if alignment was performed or pre-existing embeddings were loaded.")
}
# The assay to associate with the new DimReducObject.
# Use the same assay from which data was fetched or DefaultAssay.
assay_for_dimreduc <- DefaultAssay(new) # As per original scPred logic for CreateDimReducObject
if(is.null(assay_for_dimreduc) || !assay_for_dimreduc %in% Seurat::Assays(new)){
# Fallback if DefaultAssay is weird
assay_for_dimreduc <- assay_to_use # assay_to_use was determined earlier for GetAssayData
if(is.null(assay_for_dimreduc)){ # If alignment was skipped, assay_to_use might not be set
assay_for_dimreduc <- Seurat::Assays(new)[1]
}
message(crayon::yellow("\t", cli::symbol$info, paste0("DefaultAssay for 'new' was problematic. Associating DimReduc with assay: '", assay_for_dimreduc, "'.")))
}
new[["scpred"]] <- Seurat::CreateDimReducObject(
embeddings = new_embeddings_aligned,
key = "scpred_", # Key for the aligned embeddings
assay = assay_for_dimreduc
)
# Store the pre-Harmony projection if it was computed
if (alignment_needed && !is.null(new_embeddings_projection_only)) {
new[["scpred_projection"]] <- Seurat::CreateDimReducObject(
embeddings = new_embeddings_projection_only,
key = "Projection_", # Key for pre-Harmony projected embeddings
assay = assay_for_dimreduc
)
}
message(crayon::green("DONE! Query projection and alignment complete."))
return(new)
}
project_query_v2(query, reference)
reference <- scPred::pbmc_1
query <- scPred::pbmc_2
reference <- reference %>%
NormalizeData() %>%
FindVariableFeatures() %>%
ScaleData() %>%
RunPCA() %>%
RunUMAP(dims = 1:30)
DimPlot(reference, group.by = "cell_type", label = TRUE, repel = TRUE)
reference <- getFeatureSpace(reference, "cell_type")
reference <- trainModel(reference)
get_probabilities(reference) %>% head()
get_scpred(reference)
plot_probabilities(reference)
reference <- trainModel(reference, model = "mda", reclassify = c("cMono", "ncMono"))
get_scpred(reference)
query <- NormalizeData(query)
query <- scPredict(query, reference)
query <- RunUMAP(query, reduction = "scpred", dims = 1:30)
FeaturePlot(query, c("scpred_B.cell", "scpred_CD4.T.cell", "scpred_CD8.T.cell",
"scpred_cMono", "scpred_ncMono", "scpred_Plasma.cell",
"scpred_cDC", "scpred_pDC"))
crossTab(query, "cell_type", "scpred_prediction")
crossTab(query, "cell_type", "scpred_prediction", output = "prop")
get_classifiers(reference)
caret::plot.train(get_classifiers(reference)[["NK cell"]])
reference <- trainModel(reference, model = "glm")
get_scpred(reference)
query <- scPredict(query, reference, recompute_alignment = FALSE)
project_query_v2 <- function(new,
reference,
max.iter.harmony = 20,
recompute_alignment = TRUE,
seed = 66,
# It's good practice to define which assay in 'new' to use,
# or clearly state how it will be determined.
# Adding this as a suggestion for future improvement,
# but will follow the logic of robust auto-detection below.
# query.assay.name = NULL,
...) {
# --- 1. Input Validation and Model Extraction ---
if (!inherits(new, "Seurat")) {
stop("Input 'new' must be a Seurat object.")
}
if (!(inherits(reference, "Seurat") || inherits(reference, "scPred"))) {
stop("'reference' must be of class 'scPred' or a Seurat object containing an scPred model.")
}
spmodel <- NULL
if (inherits(reference, "Seurat")) {
if (!is.null(reference@misc$scPred) && inherits(reference@misc$scPred, "scPred")) {
spmodel <- reference@misc$scPred
} else {
stop("No 'scPred' model found in the 'misc' slot of the reference Seurat object.")
}
} else { # It's an scPred object
spmodel <- reference
}
if (is.null(spmodel)) {
stop("Failed to extract scPred model from 'reference'.") # Should be caught above, but defensive
}
if (length(spmodel@feature_loadings) == 0 || length(spmodel@cell_embeddings) == 0) {
stop("The scPred model in 'reference' appears to be incomplete (missing feature_loadings or cell_embeddings).")
}
# --- 2. Determine if Alignment is Needed ---
alignment_needed <- TRUE
if ("scpred" %in% names(new@reductions)) {
if (recompute_alignment) {
message(crayon::yellow(cli::symbol$figure_dash, " Data has already been aligned to a reference (found 'scpred' reduction)."))
message(crayon::yellow(cli::symbol$sup_plus, " Recomputing alignment as `recompute_alignment = TRUE`."))
} else {
message(crayon::blue(cli::symbol$info, " Data has already been aligned. Using existing 'scpred' reduction as `recompute_alignment = FALSE`."))
alignment_needed <- FALSE
}
}
# --- 3. Perform Alignment (if needed) ---
new_embeddings_aligned <- NULL
new_embeddings_projection_only <- NULL # To store pre-Harmony projection
if (alignment_needed) {
message(crayon::green(cli::symbol$record, " Step 1: Matching features and preparing new data..."))
ref_loadings <- spmodel@feature_loadings
reference_features <- rownames(ref_loadings)
# --- 3a. Robustly Determine Assay and Get Data from 'new' object ---
# This section is critical for avoiding the GetAssayData error
assay_to_use <- NULL
available_assays_in_new <- Seurat::Assays(new)
# Priority:
# 1. "RNA" assay if it exists (common standard for scPred like tools)
# 2. DefaultAssay if it's valid and not "data"
# 3. First valid assay from the object if others fail
if ("RNA" %in% available_assays_in_new) {
assay_to_use <- "RNA"
message(crayon::cyan("\t", cli::symbol$info, "Using 'RNA' assay from the 'new' Seurat object."))
} else {
default_assay_new <- Seurat::DefaultAssay(new)
if (!is.null(default_assay_new) && default_assay_new %in% available_assays_in_new && default_assay_new != "data") {
assay_to_use <- default_assay_new
message(crayon::cyan("\t", cli::symbol$info, paste0("Using DefaultAssay ('", default_assay_new, "') from the 'new' Seurat object.")))
} else {
# Filter out any assay literally named "data" if it somehow exists
valid_available_assays <- setdiff(available_assays_in_new, "data")
if (length(valid_available_assays) > 0) {
assay_to_use <- valid_available_assays[1]
message(crayon::yellow("\t", cli::symbol$warning, paste0("'RNA' assay not found and DefaultAssay was unsuitable. Using the first available valid assay: '", assay_to_use, "'.")))
} else {
stop("Could not find a suitable assay (e.g., 'RNA' or a valid DefaultAssay) in the 'new' Seurat object. Assays present: ", paste(available_assays_in_new, collapse=", "))
}
}
}
# Get all features from the chosen assay in the 'new' object
# Ensure the assay chosen actually has features.
if (!assay_to_use %in% names(new@assays) || nrow(new[[assay_to_use]]) == 0) {
stop(paste0("The selected assay '", assay_to_use, "' either does not exist or has no features/cells in the 'new' object."))
}
new_assay_obj <- new[[assay_to_use]]
new_features <- rownames(new_assay_obj) # Get features from the selected assay
if (length(new_features) == 0) {
stop(paste0("No features found in the '", assay_to_use, "' assay of the 'new' Seurat object."))
}
shared_features <- intersect(reference_features, new_features)
message(crayon::cyan("\t", cli::symbol$line, paste(length(reference_features), "features in reference PCA loadings.")))
message(crayon::cyan("\t", cli::symbol$line, paste(length(new_features), "features in the '", assay_to_use, "' assay of the new dataset.")))
message(crayon::cyan("\t", cli::symbol$line, paste(length(shared_features), "features shared between reference and new dataset.")))
if (length(shared_features) < 5) { # Arbitrary small number, adjust as needed
stop(paste0("Very few shared features (", length(shared_features), ") between reference and new dataset. Check feature naming consistency (e.g., gene symbols vs. Ensembl IDs)."))
}
if ((length(shared_features) / length(reference_features)) < 0.1) { # If less than 10% of reference features are shared
warning(paste0("Less than 10% (", round(length(shared_features)/length(reference_features) * 100, 2), "%) of features in the reference are present in the new dataset. Projection quality may be poor."))
}
# ... (previous parts of project_query_v2 function) ...
# --- 3b. Get Expression Data (using 'layer' for Seurat v5) ---
# Assuming 'data' layer (normalized) is desired. For counts, use 'counts'.
# scPred typically uses normalized data for projection.
expression_layer_name <- "data" # Or "counts" if you want to start from counts
message(crayon::cyan("\t", cli::symbol$info, paste0("Fetching '", expression_layer_name, "' layer from '", assay_to_use, "' assay.")))
# Check if the layer exists using Layers() without Seurat::
# new_assay_obj was defined earlier as new[[assay_to_use]]
# Ensure new_assay_obj is indeed an Assay object before calling Layers on it
if (!inherits(new_assay_obj, "Assay")) {
stop(paste0("Object retrieved for assay '", assay_to_use, "' is not a valid Seurat Assay object."))
}
# MODIFIED LINES HERE: Call Layers() without Seurat::
available_layers <- Layers(new_assay_obj) # Get available layers for the specific assay object
if (!expression_layer_name %in% available_layers) {
error_msg <- paste0("The specified expression layer '", expression_layer_name, "' was not found in the '", assay_to_use, "' assay of the 'new' object. ")
if (length(available_layers) > 0) {
error_msg <- paste0(error_msg, "Available layers are: ", paste(available_layers, collapse = ", "), ".")
if ("counts" %in% available_layers && expression_layer_name == "data") {
error_msg <- paste0(error_msg, " You might need to normalize the '", assay_to_use, "' assay first (e.g., using Seurat::NormalizeData) to create the 'data' layer.")
} else if (!"counts" %in% available_layers && expression_layer_name == "counts") {
error_msg <- paste0(error_msg, " The 'counts' layer itself is missing.")
}
} else {
error_msg <- paste0(error_msg, "No data layers found in this assay.")
}
stop(error_msg)
}
# GetAssayData should still be fine with Seurat:: as it's a workhorse exported function
new_expression_data <- Seurat::GetAssayData(object = new, assay = assay_to_use, layer = expression_layer_name)
new_expression_data_shared <- new_expression_data[shared_features, , drop = FALSE]
# ... (rest of the project_query_v2 function) ...
if (ncol(new_expression_data_shared) == 0) {
stop("No cells found in the 'new' object after subsetting for shared features. Check input.")
}
if (nrow(new_expression_data_shared) == 0) {
stop("No shared features found in the data matrix after attempting to subset. This shouldn't happen if length(shared_features)>0. Check for NA/empty rownames.")
}
# --- 3c. Scaling and Projection (as per original logic) ---
message(crayon::green(cli::symbol$record, " Step 2: Scaling data and projecting into reference PCA space..."))
ref_loadings_shared <- ref_loadings[shared_features, , drop = FALSE]
means <- spmodel@scaling$means[shared_features]
stdevs <- spmodel@scaling$stdevs[shared_features]
# Handle cases where stdevs might be NA or zero for shared features
# (e.g. if a feature was all-zero in ref during training but present in query)
if(any(is.na(means)) || any(is.na(stdevs))){
na_means_features <- names(means[is.na(means)])
na_stdevs_features <- names(stdevs[is.na(stdevs)])
bad_scaling_features <- unique(c(na_means_features, na_stdevs_features))
message(crayon::yellow("\t", cli::symbol$warning, paste0("Found ", length(bad_scaling_features), " shared features with NA scaling parameters (means/stdevs). These features will be excluded from projection.")))
# Exclude these problematic features
shared_features_for_scaling <- setdiff(shared_features, bad_scaling_features)
if(length(shared_features_for_scaling) < 5){
stop("Too few features remaining after excluding those with NA scaling parameters. Cannot proceed.")
}
new_expression_data_shared <- new_expression_data_shared[shared_features_for_scaling, , drop = FALSE]
ref_loadings_shared <- ref_loadings[shared_features_for_scaling, , drop = FALSE]
means <- spmodel@scaling$means[shared_features_for_scaling]
stdevs <- spmodel@scaling$stdevs[shared_features_for_scaling]
}
# Transpose new_expression_data_shared for scaling (cells by features)
new_expression_data_t <- Matrix::t(new_expression_data_shared)
# Identify zero-variance features in the reference scaling parameters *that are still present*
zero_variance_stdevs_idx <- (stdevs == 0)
if (any(zero_variance_stdevs_idx)) {
num_zero_var <- sum(zero_variance_stdevs_idx)
warning(paste0(num_zero_var, " shared features had zero variance in the reference during training (stdev=0). These features will be effectively removed from projection for the new data, or cause NaNs if not handled by scale()."))
# The standard scale() function handles stdev=0 by not scaling those columns (outputting 0s if center=TRUE and data matched mean, or original if center=FALSE, or NaNs/Infs if data != mean).
# scPred's original code removed these, let's see if `scale` handles it or if we need to replicate the removal.
# If means[zero_variance_stdevs_idx] makes sense and data is also that mean, then (x-mean)/stdev -> 0/0 -> NaN.
# It's often safer to remove such features before scaling if stdev is truly 0.
# However, scPred's original logic was:
# i <- stdevs == 0 ... new_data <- new_data[, !i]; ref_loadings <- ref_loadings[!i, ]; means <- means[!i]; stdevs <- stdevs[!i]
# This was applied AFTER data was transposed.
# Let's apply this logic carefully.
if(any(zero_variance_stdevs_idx)){
message(crayon::yellow("\t", cli::symbol$info, "Removing features with zero standard deviation in reference scaling parameters from projection."))
# Features to keep for scaling are those where stdevs != 0
features_to_keep_idx <- !zero_variance_stdevs_idx
new_expression_data_t <- new_expression_data_t[, features_to_keep_idx, drop = FALSE]
ref_loadings_shared <- ref_loadings_shared[features_to_keep_idx, , drop = FALSE]
means <- means[features_to_keep_idx]
stdevs <- stdevs[features_to_keep_idx]
if(ncol(new_expression_data_t) < 1 || nrow(ref_loadings_shared) < 1){
stop("No features left for projection after removing zero-variance features. Check reference model training.")
}
}
}
# Perform scaling: (data - center) / scale
# The `scale` function in R handles this.
# It expects data where columns are variables (features).
scaled_new_data <- scale(new_expression_data_t, center = means, scale = stdevs)
# Check for NaNs produced by scaling (e.g. 0/0 if a feature was constant in new data and matched mean)
if(any(is.na(scaled_new_data))){
num_nans <- sum(is.na(scaled_new_data))
message(crayon::yellow("\t", cli::symbol$warning, paste0(num_nans, " NaN values produced after scaling. This can happen if new data has features with zero variance that also match the reference mean, or if a feature that had variance in reference is all 0s in query. These will be converted to 0.")))
scaled_new_data[is.na(scaled_new_data)] <- 0 # Replace NaNs with 0
}
# Project scaled data into reference PCA space
new_embeddings_projection_only <- scaled_new_data %*% ref_loadings_shared
# --- 3d. Harmony Alignment (as per original logic) ---
message(crayon::green(cli::symbol$record, " Step 3: Aligning new data to reference using Harmony..."))
ref_cell_embeddings <- spmodel@cell_embeddings
# Ensure column names match for rbind
if(!identical(colnames(ref_cell_embeddings), colnames(new_embeddings_projection_only))){
# This can happen if PCA dimensions differ slightly or names are off.
# scPred model stores PCs, new projection should match these.
# If new_embeddings_projection_only has more/less cols, this is an issue.
# The colnames(new_embeddings_aligned) <- colnames(spmodel@cell_embeddings) from original scPredict was after harmony.
# For Harmony, they must match before rbind.
# ref_loadings_shared drives the colnames of new_embeddings_projection_only.
# And ref_cell_embeddings should also match those PC names.
# This implies colnames(ref_loadings_shared) should match colnames(ref_cell_embeddings) conceptually.
# Let's assume they do match as per scPred's internal consistency.
warning("Column names of reference embeddings and new projected embeddings do not perfectly match. This might cause issues with Harmony if PC names are inconsistent. Proceeding with caution.")
# A safer approach might be to intersect colnames or ensure spmodel internals are consistent.
# For now, assuming they are compatible as per scPred's design.
}
# Create combined data for Harmony
# Ensure unique rownames for Harmony
harmony_ref_embeddings <- ref_cell_embeddings
rownames(harmony_ref_embeddings) <- paste0("ref_", rownames(harmony_ref_embeddings))
harmony_new_embeddings <- new_embeddings_projection_only
rownames(harmony_new_embeddings) <- paste0("new_", rownames(harmony_new_embeddings))
combined_embeddings <- rbind(harmony_ref_embeddings, harmony_new_embeddings)
meta_data_harmony <- data.frame(
original_rownames = rownames(combined_embeddings), # Keep track for later
dataset = factor(
c(rep("reference", nrow(harmony_ref_embeddings)), rep("new", nrow(harmony_new_embeddings))),
levels = c("reference", "new")
)
)
rownames(meta_data_harmony) <- meta_data_harmony$original_rownames
set.seed(seed)
# The '...' passes additional arguments to HarmonyMatrix if any are provided to project_query_v2
harmony_aligned_embeddings <- harmony::HarmonyMatrix(
data_mat = combined_embeddings,
meta_data = meta_data_harmony,
vars_use = "dataset", # Variable to integrate over
do_pca = FALSE,       # PCA already done
reference_values = "reference", # Which dataset level is the reference
max.iter.harmony = max.iter.harmony,
...
)
# Extract aligned embeddings for the new dataset
new_embeddings_aligned <- harmony_aligned_embeddings[meta_data_harmony$dataset == "new", , drop = FALSE]
# Restore original rownames for the new data
original_new_rownames <- rownames(new_embeddings_projection_only) # These are the cell names from 'new'
rownames(new_embeddings_aligned) <- original_new_rownames
} else { # alignment_needed is FALSE
message(crayon::blue(cli::symbol$info, "Skipping alignment. Using existing 'scpred' reduction."))
new_embeddings_aligned <- Seurat::Embeddings(new, reduction = "scpred")
# Original scPredict code had:
# colnames(new_embeddings_aligned) <- gsub("scpred_", spmodel@reduction_key, colnames(new_embeddings_aligned))
# This line is a bit confusing as reduction_key is usually like "PC_" or "harmony_" not part of "scpred_"
# And spmodel@reduction_key is for the *reference* model reduction.
# Let's assume 'scpred' reduction in 'new' already has appropriate colnames.
# If original scpred_projection is needed, it should also be fetched or ensured it exists.
if ("scpred_projection" %in% names(new@reductions)) {
new_embeddings_projection_only <- Seurat::Embeddings(new, reduction = "scpred_projection")
}
}
# --- 4. Store Embeddings in 'new' Seurat Object ---
message(crayon::green(cli::symbol$record, " Step 4: Storing new embeddings in the Seurat object..."))
# Ensure new_embeddings_aligned is not NULL (e.g. if alignment was skipped and no 'scpred' reduction found)
if(is.null(new_embeddings_aligned)){
stop("Aligned embeddings are NULL. This should not happen if alignment was performed or pre-existing embeddings were loaded.")
}
# The assay to associate with the new DimReducObject.
# Use the same assay from which data was fetched or DefaultAssay.
assay_for_dimreduc <- DefaultAssay(new) # As per original scPred logic for CreateDimReducObject
if(is.null(assay_for_dimreduc) || !assay_for_dimreduc %in% Seurat::Assays(new)){
# Fallback if DefaultAssay is weird
assay_for_dimreduc <- assay_to_use # assay_to_use was determined earlier for GetAssayData
if(is.null(assay_for_dimreduc)){ # If alignment was skipped, assay_to_use might not be set
assay_for_dimreduc <- Seurat::Assays(new)[1]
}
message(crayon::yellow("\t", cli::symbol$info, paste0("DefaultAssay for 'new' was problematic. Associating DimReduc with assay: '", assay_for_dimreduc, "'.")))
}
new[["scpred"]] <- Seurat::CreateDimReducObject(
embeddings = new_embeddings_aligned,
key = "scpred_", # Key for the aligned embeddings
assay = assay_for_dimreduc
)
# Store the pre-Harmony projection if it was computed
if (alignment_needed && !is.null(new_embeddings_projection_only)) {
new[["scpred_projection"]] <- Seurat::CreateDimReducObject(
embeddings = new_embeddings_projection_only,
key = "Projection_", # Key for pre-Harmony projected embeddings
assay = assay_for_dimreduc
)
}
message(crayon::green("DONE! Query projection and alignment complete."))
return(new)
}
project_query_v2(query, reference)
fix(project_query)
query <- scPredict(query, reference, recompute_alignment = FALSE)
query <- scPredict(query, reference)
